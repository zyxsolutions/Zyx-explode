<UserControl x:Class="ZyxExplode.MaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">

            <Grid Margin="0,0,0,20">
                <StackPanel Margin="0,0,260,0">
                    <TextBlock Text="MANUTENÇÃO" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap"
                               Text="Reparo do Windows, rede, energia e limpeza · cada tarefa mostra o comando exato antes de rodar"/>
                </StackPanel>
                <Button x:Name="BtnRun" Style="{StaticResource PrimaryButton}" Content="EXECUTAR SELECIONADAS" Padding="20,9"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnRun_Click"/>
            </Grid>

            <TextBlock x:Name="MaintStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="MaintProgress" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Faint}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,16" MinHeight="16"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="TAREFAS" Style="{StaticResource Label}"/>
                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource OutlineButton}" Content="MARCAR RÁPIDAS" Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="BtnQuick_Click"/>
                            <Button Style="{StaticResource OutlineButton}" Content="DESMARCAR" Padding="10,4" FontSize="11" Click="BtnNone_Click"/>
                        </WrapPanel>
                    </Grid>
                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6">
                        As tarefas rodam uma de cada vez e podem ser canceladas. Nenhuma desinstala programas nem apaga documentos.
                        O SFC, o DISM e o chkdsk demoram: deixe o PC ligado na tomada até terminarem.
                    </TextBlock>
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="0,18,0,6"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding CommandText}" FontFamily="{StaticResource Mono}" FontSize="11"
                                                       Foreground="{DynamicResource Faint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="14,3,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="18,14,10,10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="REGISTRO" Style="{StaticResource Label}"/>
                        <Button Style="{StaticResource OutlineButton}" Content="LIMPAR" Padding="10,3" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0" Click="BtnClearLog_Click"/>
                    </Grid>
                    <ListBox x:Name="MaintLog" Height="300" FontFamily="{StaticResource Mono}" FontSize="12"
                             Foreground="{DynamicResource Muted}" ItemContainerStyle="{StaticResource PlainItem}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
