<UserControl x:Class="ZyxExplode.MonitorTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">

            <Grid Margin="0,0,0,20">
                <StackPanel Margin="0,0,260,0">
                    <TextBlock Text="TESTE DE MONITOR" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap"
                               Text="Seis testes em tela cheia para checar pixels, cores, movimento e taxa de atualização"/>
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="ABRIR OS TESTES" Padding="20,9"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnOpen_Click"/>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="OS TESTES" Style="{StaticResource Label}"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="22">
                        <Run FontWeight="SemiBold" Text="1 · Cores sólidas."/>
                        <Run Foreground="{DynamicResource Muted}" Text=" Tela inteira de uma cor só. Procure pontos que não mudam (pixels mortos ou presos) e manchas claras no preto (vazamento de luz)."/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Text="2 · Gradientes."/>
                        <Run Foreground="{DynamicResource Muted}" Text=" Rampas de cinza e de cada cor. Faixas visíveis em vez de uma transição suave indicam bandas de cor."/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Text="3 · Movimento."/>
                        <Run Foreground="{DynamicResource Muted}" Text=" Um quadrado listrado cruza a tela em velocidade constante. Siga-o com os olhos: borrão ou sombra atrás dele indica resposta lenta (ghosting)."/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Text="4 · Padrões de pixel."/>
                        <Run Foreground="{DynamicResource Muted}" Text=" Colunas, linhas e xadrez de 1 pixel, para ver a nitidez e problemas de escala ou de sinal."/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Text="5 · Grade e geometria."/>
                        <Run Foreground="{DynamicResource Muted}" Text=" Círculos, retas e marcas nos cantos, para ver se a imagem está cortada ou esticada."/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Text="6 · Taxa de atualização e quadros."/>
                        <Run Foreground="{DynamicResource Muted}" Text=" Compara a taxa configurada no Windows com os quadros que a janela realmente recebe, e conta os quadros pulados."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="TECLAS" Style="{StaticResource Label}"/>
                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="22">
                        Tab ou 1 a 6: troca de teste · ← → (ou clique): muda a cor ou a variação · ↑ ↓: velocidade (teste de movimento)
                        <LineBreak/>
                        H: fixa ou esconde a caixa de ajuda · Esc: sai
                        <LineBreak/>
                        <LineBreak/>
                        O teste abre no monitor onde o programa está. Em PC com mais de um monitor, arraste o ZYX EXPLODE para a tela que quer testar antes de abrir.
                        A caixa de ajuda some sozinha depois de alguns segundos, para não atrapalhar a procura por pixels.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
