<UserControl x:Class="ZyxExplode.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="Page_IsVisibleChanged">

    <UserControl.Resources>
        <Style x:Key="MonoCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        </Style>
        <Style x:Key="MutedMonoCell" TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style x:Key="StatSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">

            <Grid Margin="0,0,0,20">
                <StackPanel Margin="0,0,330,0">
                    <TextBlock Text="MEMÓRIA" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource Sub}" TextWrapping="Wrap"
                               Text="Como o Windows está usando a RAM: em uso, em cache, esperando o disco ou livre. Estilo RAMMap."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <CheckBox x:Name="ChkAuto" Content="Atualizar sozinho" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="18,9" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>

            <!-- Barra de uso -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="BarTitle" Text="USO DA RAM" Style="{StaticResource Label}"/>
                    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Margin="0,2,0,12">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColInUse" Width="1*"/>
                                <ColumnDefinition x:Name="ColModified" Width="0*"/>
                                <ColumnDefinition x:Name="ColStandby" Width="0*"/>
                                <ColumnDefinition x:Name="ColFree" Width="0*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Fg}"/>
                            <Border Grid.Column="1" Background="{DynamicResource Faint}"/>
                            <Border Grid.Column="2" Background="{DynamicResource LineStrong}"/>
                            <Border Grid.Column="3" Background="{DynamicResource Line}"/>
                        </Grid>
                    </Border>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                            <Border Width="11" Height="11" Background="{DynamicResource Fg}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LegInUse" Foreground="{DynamicResource Muted}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                            <Border Width="11" Height="11" Background="{DynamicResource Faint}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LegModified" Foreground="{DynamicResource Muted}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                            <Border Width="11" Height="11" Background="{DynamicResource LineStrong}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LegStandby" Foreground="{DynamicResource Muted}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="11" Height="11" Background="{DynamicResource Line}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LegFree" Foreground="{DynamicResource Muted}" FontSize="12"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Números -->
            <UniformGrid Columns="4" Margin="0,0,-10,0">
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="TOTAL" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StTotal" Style="{StaticResource Big}" Text="—"/>
                        <TextBlock x:Name="StTotalSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="EM USO" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StInUse" Style="{StaticResource Big}" Text="—"/>
                        <TextBlock x:Name="StInUseSub" Style="{StaticResource StatSub}" Text="Programas e sistema (working sets, drivers, kernel)."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="STANDBY (CACHE)" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StStandby" Style="{StaticResource Big}" Text="—"/>
                        <TextBlock x:Name="StStandbySub" Style="{StaticResource StatSub}" Text="Dados em cache que o Windows reaproveita ou descarta na hora."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="MODIFICADA" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StModified" Style="{StaticResource Big}" Text="—"/>
                        <TextBlock x:Name="StModifiedSub" Style="{StaticResource StatSub}" Text="Alterada na RAM, esperando ser gravada no disco."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="LIVRE + ZERADA" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StFree" Style="{StaticResource Big}" Text="—"/>
                        <TextBlock x:Name="StFreeSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="CACHE DO SISTEMA" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StCache" Style="{StaticResource Big}" Text="—"/>
                        <TextBlock Style="{StaticResource StatSub}" Text="Arquivos e metadados em cache pelo Windows."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="COMMIT" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StCommit" Style="{StaticResource Big}" Text="—"/>
                        <TextBlock x:Name="StCommitSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="POOLS DO KERNEL" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StPools" Style="{StaticResource Big}" Text="—"/>
                        <TextBlock x:Name="StPoolsSub" Style="{StaticResource StatSub}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Standby por prioridade + leitura do estado -->
            <Grid Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="STANDBY POR PRIORIDADE" Style="{StaticResource Label}"/>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="O Windows descarta primeiro as prioridades baixas. A 0 é a que o botão de prioridade 0 esvazia."/>
                        <ItemsControl x:Name="PriList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="92"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" Height="6" Margin="8,0,12,0" Background="{DynamicResource Line}" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Fraction}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="LEITURA DO ESTADO" Style="{StaticResource Label}"/>
                        <ItemsControl x:Name="DiagList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12.5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ações -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ESVAZIAR" Style="{StaticResource Label}"/>
                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                        Nada disso apaga arquivos nem fecha programas: o Windows só devolve ou regrava memória, e traz de volta o que for usado de novo.
                        O efeito costuma ser momentâneo. Serve para diagnosticar e para aliviar engasgos, não substitui ter RAM suficiente.
                    </TextBlock>
                    <WrapPanel>
                        <Button Style="{StaticResource OutlineButton}" Content="WORKING SETS" Padding="14,8" Margin="0,0,8,8" Click="BtnEmptyWs_Click"
                                ToolTip="Tira dos programas a memória que eles não estão usando agora (ela vai para standby/modificada)."/>
                        <Button Style="{StaticResource OutlineButton}" Content="WORKING SET DO SISTEMA" Padding="14,8" Margin="0,0,8,8" Click="BtnEmptySys_Click"
                                ToolTip="Esvazia o cache de arquivos do kernel."/>
                        <Button Style="{StaticResource OutlineButton}" Content="LISTA MODIFICADA" Padding="14,8" Margin="0,0,8,8" Click="BtnEmptyMod_Click"
                                ToolTip="Grava no disco as páginas modificadas e as move para standby."/>
                        <Button Style="{StaticResource OutlineButton}" Content="STANDBY" Padding="14,8" Margin="0,0,8,8" Click="BtnEmptyStandby_Click"
                                ToolTip="Esvazia toda a lista de espera (cache)."/>
                        <Button Style="{StaticResource OutlineButton}" Content="STANDBY PRIORIDADE 0" Padding="14,8" Margin="0,0,8,8" Click="BtnEmptyStandby0_Click"
                                ToolTip="Esvazia só a parte de menor prioridade da lista de espera."/>
                        <Button Style="{StaticResource PrimaryButton}" Content="ESVAZIAR TUDO" Padding="18,8" Margin="0,0,0,8" Click="BtnEmptyAll_Click"
                                ToolTip="Working sets, sistema, modificada e standby, nessa ordem."/>
                    </WrapPanel>
                    <TextBlock x:Name="ActionResult" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Processos -->
            <Border Style="{StaticResource CardBorder}" Padding="20,18,14,12">
                <StackPanel>
                    <Grid Margin="0,0,6,10">
                        <TextBlock Text="PROCESSOS POR MEMÓRIA" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="ProcSearch" Width="220" Tag="Buscar processo…" TextChanged="ProcSearch_Changed" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource OutlineButton}" Content="ESVAZIAR O SELECIONADO" Padding="12,5" FontSize="11" Click="BtnTrimSelected_Click"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="ProcGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="False" Height="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROCESSO" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90" ElementStyle="{StaticResource MutedMonoCell}"/>
                            <DataGridTextColumn Header="NA RAM AGORA" Binding="{Binding WorkingSetText}" SortMemberPath="WorkingSet" Width="150" ElementStyle="{StaticResource MonoCell}"/>
                            <DataGridTextColumn Header="PRIVADA" Binding="{Binding PrivateText}" SortMemberPath="Private" Width="140" ElementStyle="{StaticResource MutedMonoCell}"/>
                            <DataGridTextColumn Header="PICO" Binding="{Binding PeakText}" SortMemberPath="Peak" Width="140" ElementStyle="{StaticResource MutedMonoCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ProcStatus" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
